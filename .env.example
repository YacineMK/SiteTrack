PORT=:8080
JWT_SECRET=placeholder
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
COOKIE_SECURE=false

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=sitetrack
POSTGRES_PASSWORD=sitetrack
POSTGRES_DB=sitetrack
POSTGRES_SSLMODE=disable

DATABASE_URL=postgres://sitetrack:sitetrack@localhost:5432/sitetrack?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=sitetrack
REDIS_DB=0
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE_CONNS=2
REDIS_CONN_MAX_LIFETIME=5m
REDIS_CONN_MAX_IDLE_TIME=30m

RESEND_API_KEY=placeholder
APP_PORT=8080
PROD_DATABASE_URL=postgres://USER:PASSWORD@postgres:5432/DB?sslmode=disable
PROD_REDIS_ADDR=redis:6379
RESEND_FROM=onboarding@resend.dev
RESEND_BASE_URL=https://api.resend.com
INVITE_TTL=1h
APP_BASE_URL=http://localhost:8080

WORKER_CONCURRENCY=5
OUTBOX_BATCH_SIZE=20
OUTBOX_POLL_INTERVAL=2s
OUTBOX_LOCK_TIMEOUT=1m
OUTBOX_MAX_ATTEMPTS=5
