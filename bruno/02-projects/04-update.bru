meta {
  name: Update project
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/projects/{{projectId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "description": "Level 2 slab works"
  }
}

docs {
  Project admin only. Partial PATCH — send only the fields you want to
  change. Accepted: name, description, planned_start_date, planned_end_date.
  200 -> ProjectResponse. 403 for members who are not admins.
}
