meta {
  name: Invite
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/projects/{{projectId}}/invitations
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "seed.user2@example.com",
    "role": "member"
  }
}

script:post-response {
  bru.setEnvVar("invitationId", res.body.id);
}

docs {
  Project admin only. role: member | admin. The invitee gets a notification
  and joins only after accepting. 201 -> InvitationResponse. 409 if pending.
}
