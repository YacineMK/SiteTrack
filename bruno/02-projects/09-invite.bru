meta {
  name: Invite
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/projects/{{projectId}}/invitations
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "seed.user2@example.com",
    "role_id": "{{projectRoleId}}"
  }
}

script:post-response {
  bru.setEnvVar("invitationId", res.body.id);
}

docs {
  Project admin only. role_id is optional — omit to assign the project's
  default Member role. The invitee gets a notification and joins only
  after accepting. One-time use (claim lives in Redis). 201 ->
  InvitationResponse. 409 if a pending invitation already exists.
}
