meta {
  name: Set member admin
  type: http
  seq: 7
}

patch {
  url: {{baseUrl}}/projects/{{projectId}}/members/{{memberUserId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "is_admin": true
  }
}

docs {
  Project admin only. 204. 409 if it would remove the last admin.
}
