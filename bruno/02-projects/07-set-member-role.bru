meta {
  name: Set member role
  type: http
  seq: 7
}

patch {
  url: {{baseUrl}}/projects/{{projectId}}/members/{{memberUserId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "role_id": "{{projectRoleId}}"
  }
}

docs {
  Project admin only. role_id must belong to this project (or be a system
  project role). 204. 404 if the role is not in this project's scope.
  409 if it would remove the last admin.
}
