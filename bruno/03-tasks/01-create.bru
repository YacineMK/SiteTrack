meta {
  name: Create task
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/projects/{{projectId}}/tasks
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Pour level 2 slab",
    "planned_start_date": "2026-02-01",
    "planned_end_date": "2026-02-10"
  }
}

script:post-response {
  bru.setEnvVar("taskId", res.body.display_id);
}

docs {
  Project member. 201 -> TaskResponse. Status starts at not_started.
  display_id = {{projectId}}-T-0001, -T-0002, ...
}
