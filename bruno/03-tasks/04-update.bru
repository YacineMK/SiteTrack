meta {
  name: Update task
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/projects/{{projectId}}/tasks/{{taskId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Pour level 2 slab (north)"
  }
}

docs {
  Project member. Partial PATCH — send only the fields you want to change.
  Accepted: name, planned_start_date, planned_end_date. Status is not
  editable here (use /start, /done, /reopen). 200 -> TaskResponse.
}
