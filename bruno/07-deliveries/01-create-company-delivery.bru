meta {
  name: Create company delivery
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/company-store/deliveries
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "receiver_project": "{{projectId}}",
    "lines": [
      { "material_id": "{{materialId}}", "quantity": 10 }
    ]
  }
}

script:post-response {
  bru.setEnvVar("deliveryId", res.body.id);
}

docs {
  Company store manager only. Quantities leave the company store immediately
  and the delivery is in_transit. 201 -> DeliveryResponse with lines.
  409 -> insufficient stock.
}
