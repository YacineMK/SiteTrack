meta {
  name: Update material
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/materials/{{materialId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "category": "binder"
  }
}

docs {
  Partial PATCH — send only the fields you want to change. Accepted:
  name, category, unit. 200 -> MaterialResponse. 409 -> duplicate name.
}
