meta {
  name: Register
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "New Manager",
    "email": "manager@example.com",
    "password": "Password123!",
    "app_role": "company_store_manager"
  }
}

docs {
  app_role: user | company_store_manager | super_admin.
  201 -> UserResponse. 409 -> email already registered.
}
